<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LocalAiDemos.Shared.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />

            <StackPanel Spacing="4">
                <TextBlock Text="Foundry Local model alias" />
                <TextBox x:Name="ModelBox" PlaceholderText="phi-4-mini" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Device preference" />
                <ComboBox x:Name="DeviceBox" MinWidth="220">
                    <ComboBoxItem Content="Auto" Tag="auto" />
                    <ComboBoxItem Content="NPU" Tag="npu" />
                    <ComboBoxItem Content="GPU" Tag="gpu" />
                    <ComboBoxItem Content="CPU" Tag="cpu" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Theme" />
                <ComboBox x:Name="ThemeBox" MinWidth="220">
                    <ComboBoxItem Content="Default" Tag="Default" />
                    <ComboBoxItem Content="Houston" Tag="Houston" />
                    <ComboBoxItem Content="EY" Tag="EY" />
                    <ComboBoxItem Content="CBA" Tag="CBA" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Telemetry (local audit log)" />
                <ToggleSwitch x:Name="TelemetryToggle" />
            </StackPanel>

            <Button Content="Save" Style="{ThemeResource AccentButtonStyle}" Click="Save_Click" />
            <TextBlock x:Name="SavedText" Opacity="0.7" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
