<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LocalAIDevHarness.Pages.DocSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Document summary" />
            <TextBlock Opacity="0.7" Text="Paste a document, click Summarize, watch the on-device SLM stream a short summary." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Load sample" Click="LoadSample_Click" />
            <Button Content="Summarize" Style="{ThemeResource AccentButtonStyle}" Click="Summarize_Click" />
            <Button Content="Clear" Click="Clear_Click" />
        </StackPanel>

        <TextBox x:Name="InputBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                 PlaceholderText="Paste document text here…" />

        <TextBlock Grid.Row="3" Text="Summary" FontWeight="SemiBold" Margin="0,8,0,0" />
        <Border Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="12">
            <ScrollViewer>
                <TextBlock x:Name="OutputText" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
