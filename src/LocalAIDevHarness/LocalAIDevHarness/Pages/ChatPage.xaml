<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LocalAIDevHarness.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LocalAiDemos.Shared.Controls">
    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="On-device chat" />
            <TextBlock Opacity="0.7" Text="Streamed from the Foundry Local SLM. Nothing leaves the device." />
        </StackPanel>
        <controls:StreamingChatView x:Name="Chat" Grid.Row="1" />
    </Grid>
</Page>
