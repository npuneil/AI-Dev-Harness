<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>Local AI Demos</Authors>
    <Company>Local AI Demos</Company>
    <Copyright>© Local AI Demos. Sample code.</Copyright>
    <RepositoryUrl>https://github.com/npuneil/AI-Dev-Harness</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Foundry Local + Windows App SDK shared versions -->
    <FoundryLocalVersion>1.2.0</FoundryLocalVersion>
    <WindowsAppSdkVersion>2.1.3</WindowsAppSdkVersion>
    <CommunityToolkitMvvmVersion>8.3.2</CommunityToolkitMvvmVersion>
    <OpenAIVersion>2.1.0</OpenAIVersion>
    <AzureAIInferenceVersion>1.0.0-beta.2</AzureAIInferenceVersion>
  </PropertyGroup>
</Project>
